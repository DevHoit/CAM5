# CAM5 CORE — producción. Copia a `.env` y completa. NO lo subas al repositorio.

# ── Dominio ───────────────────────────────────────────────────────────────────
# Caddy pide y renueva el certificado para este nombre automáticamente.
CAM5_DOMAIN=hoitlive.com

# ── Base de datos ─────────────────────────────────────────────────────────────
# Genera una larga: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Administrador inicial ─────────────────────────────────────────────────────
# Cuenta que crea `node src/seed.ts`. Cámbiala por la real antes de sembrar.
CAM5_ADMIN_EMAIL=admin@example.com
CAM5_ADMIN_NAME=Administrador

# ── Aplicación ────────────────────────────────────────────────────────────────
CAM5_ASSET_ID=MCC-01
LOG_LEVEL=info

# Días de serie cruda antes de podar la partición. Los agregados no se borran.
CAM5_RAW_RETENTION_DAYS=90

# Portal y API comparten origen bajo /cam5, así que CORS no hace falta.
# Déjalo vacío salvo que sirvas el portal desde otro dominio.
CAM5_CORS_ORIGINS=

# ── Autenticación (PROVISIONAL) ───────────────────────────────────────────────
# Mientras no exista sesión real, la API asume este usuario para el portal.
# Cualquiera con acceso a la URL entra como él. Implementa la sesión real
# antes de exponer el portal a terceros.
CAM5_DEV_USER=admin@example.com

# ── Credenciales del gateway ──────────────────────────────────────────────────
# Las imprime `node src/seed.ts` una sola vez. Guárdalas en el gestor de
# contraseñas y cárgalas en el gateway, no aquí.
# CAM5_GATEWAY_KEY=
# CAM5_GATEWAY_SECRET=

# ── Ritmo de muestreo ─────────────────────────────────────────────────────────
# Cada cuántos segundos el gateway toma y envía una muestra. De este valor se
# derivan el umbral de frescura del portal y el latido, para que no queden
# desalineados. 5 = tiempo casi real; 300 = una muestra cada 5 minutos.
CAM5_SAMPLE_INTERVAL_S=5

# periodic = serie regular, más simple. report-by-exception = sólo al cambiar.
# Con muestreo de 1 minuto o más espaciado, `periodic` es lo natural.
CAM5_SAMPLE_MODE=report-by-exception

# Agregado por minuto. Sólo aporta con muestreo sub-minuto: si las muestras
# llegan cada 1-5 minutos guarda las mismas filas que la tabla cruda y más
# pesadas, duplicando el almacenamiento sin acelerar nada.
CAM5_ROLLUP_1M=true

# Cuántos lectores IRM cuelgan del CAM-5 al sembrar. 0 = una sola unidad.
CAM5_SEED_READERS=9

# Umbral de frescura, en segundos. Si lo dejas vacío se calcula como 2,5 veces
# el período de muestreo, que es lo correcto en casi todos los casos.
# CAM5_STALE_AFTER_S=
