# Base de datos
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql://cam5:cambia-esto@localhost:5432/cam5

# API
PORT=8787
LOG_LEVEL=info

# Exigir firma HMAC en la ingesta. Déjalo en true fuera de desarrollo.
CAM5_REQUIRE_HMAC=true

# Días de serie cruda antes de podar la partición. Los agregados no se borran.
CAM5_RAW_RETENTION_DAYS=90

# Sólo desarrollo: identidad de usuario asumida cuando no hay sesión real.
# CAM5_DEV_USER=admin@example.com

# --- Credenciales del gateway (las imprime `npm run seed`) ---
# CAM5_GATEWAY_KEY=
# CAM5_GATEWAY_SECRET=

# Orígenes permitidos para el portal (separados por coma). Ej.: http://localhost:3000
CAM5_CORS_ORIGINS=http://localhost:3000
