# URL del backend CAM5 CORE. Si falta, el portal arranca en modo demostración
# con los datos simulados originales.
NEXT_PUBLIC_CAM5_API_URL=http://localhost:8787/api/v1

# Activo que muestra el portal.
NEXT_PUBLIC_CAM5_ASSET_ID=MCC-01

# Ruta bajo la que se sirve el portal. Vacío = raíz del dominio.
# En producción sobre hoitlive.com/cam5:  /cam5
NEXT_PUBLIC_CAM5_BASE_PATH=

# Cuánto puede envejecer una lectura antes de mostrarse como atrasada.
# DEBE ser mayor que el período de muestreo del gateway: con lecturas cada
# 5 minutos y el valor por defecto de 60 s, el tablero se vería permanentemente
# atrasado aunque todo funcione. Regla práctica: 2,5 ciclos.
#   muestreo cada   5 s  →  60
#   muestreo cada  60 s  →  150
#   muestreo cada 300 s  →  750
NEXT_PUBLIC_CAM5_STALE_AFTER_S=60
